{
  "name": "onboard-release-candidate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx scripts/dev.ts --local-demo-auto-auth",
    "dev:vite": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "node --env-file-if-exists=.env.test.local ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:http": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-http.ts",
    "test:demo": "node --env-file-if-exists=.env.local --import tsx scripts/verify-maryam-http.ts",
    "db:inspect": "node --env-file-if-exists=.env.local --import tsx scripts/inspect-database.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^24.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
